# Copy this file to .env and fill in real values. Never commit the real .env file.

# Mapbox public access token (pk.*) used at runtime to render maps/styles.
# Create one at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_access_token

# Mapbox secret downloads token (sk.* with DOWNLOADS:READ scope), used only
# during native builds to fetch the Mapbox SDK. Create one at the same URL
# with the "Downloads:Read" scope enabled.
MAPBOX_DOWNLOAD_TOKEN=sk.your_mapbox_downloads_token

# Supabase project URL and anon/public API key.
# Find these in your Supabase project under Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
